# Firebase client config (from Firebase console → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# Firebase Admin SDK (from downloaded service account JSON)
FIREBASE_PROJECT_ID="compale"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# next-auth — generate secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transcoder worker (receives presigned R2 URL, streams fMP4). Set to enable avi playback.
NEXT_PUBLIC_TRANSCODER_URL=http://localhost:8080
# Optional: same value for server-side helper (fallback)
TRANSCODER_URL=http://localhost:8080
# Optional auth for worker (must match transcoder's TRANSCODE_WORKER_SECRET)
TRANSCODE_WORKER_SECRET=

MEDIA_ENCRYPTION_KEY=
